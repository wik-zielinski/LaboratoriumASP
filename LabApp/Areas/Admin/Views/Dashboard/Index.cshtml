@model IReadOnlyList<KeyValuePair<string, long>>

<h2>Dashboard Admina</h2>

<p>Łączna liczba żądań do serwera: <strong>@ViewBag.TotalRequests</strong></p>

<h3>5 najpopularniejszych ścieżek</h3>
<table>
    <thead>
    <tr>
        <th>Ścieżka</th>
        <th>Liczba żądań</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><code>@item.Key</code></td>
            <td>@item.Value</td>
        </tr>
    }
    </tbody>
</table>