@model List<Book>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Lista książek</h2>
<a class="btn btn-primary" asp-action="Create" asp-controller="Book">Dodaj książke</a>
<table class="table">
    <thead>
    <th>
        Tytuł
    </th>
    <th>
        Autor
    </th>
    <th>
        Rok
    </th>
    <th>Cena</th>
    </thead>
    <tbody>
        @{
            foreach (var book in Model)
            {
                <partial model=@book name="_BookRow"/>
            }
        }
    </tbody>
</table>
