@model List<Book>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Lista książek</h2>
<a class="btn btn-primary mb-3" asp-action="Create" asp-controller="Book">+ Dodaj książke</a>
<table class="table">
    <thead>
    <th>
        Tytuł
    </th>
    <th>
        Autor
    </th>
    <th>
        Rok
    </th>
    <th>Cena</th>
    </thead>
    <tbody>
        @{
            foreach (var book in Model)
            {
                <partial model=@book name="_BookRow"/>
            }
        }
    </tbody>
</table>


@section Styles {
    <style>
        h2 {
            color: #6f42c1;
        }
    </style>
}

@section Footer {
    <span class="ms-3">| Sekcja stopki z widoku listy książek</span>
}

@section Scripts {
    <script>
        console.log("Skrypt z widoku Book/Index został pomyślnie uruchomiony!");
    </script>
}